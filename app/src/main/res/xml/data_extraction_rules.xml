<?xml version="1.0" encoding="utf-8"?><!--
   云备份 / 设备迁移（API 31+）的数据提取规则。
   与 backup_rules.xml 对应：日志目录不参与云备份与设备迁移，
   理由同上——调试产物占配额、崩溃现场要「当下」的。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="logs" />
    </device-transfer>
</data-extraction-rules>
