<?xml version="1.0" encoding="utf-8"?><!--
   云备份 / 设备迁移（API 31+）的数据提取规则。
   与 backup_rules.xml 对应：日志目录不参与云备份与设备迁移，
   理由同上——调试产物占配额、崩溃现场要「当下」的。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 日志目录（运行日志 / 崩溃报告 / 导出文件）不参与云备份 -->
        <exclude
            domain="file"
            path="logs" />
        <!-- DataStore 不参与云备份：登录凭据与设备绑定，换机后无法解密 -->
        <exclude
            domain="file"
            path="datastore" />
    </cloud-backup>
    <device-transfer>
        <!-- 日志目录不参与设备迁移 -->
        <exclude
            domain="file"
            path="logs" />
        <!-- DataStore 不参与设备迁移：同上，登录态在旧设备上解不开 -->
        <exclude
            domain="file"
            path="datastore" />
    </device-transfer>
</data-extraction-rules>
