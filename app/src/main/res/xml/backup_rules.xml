<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules（API 23~30 的 full-backup-content 兼容层）。
   日志目录属于本地调试产物，不值得占用云备份配额，也会拖慢备份恢复，
   排除之；崩溃报告要的是「当下」的现场，跨设备恢复旧日志反而会误导排查。
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- 日志目录（运行日志 / 崩溃报告 / 导出文件）不参与云备份 -->
    <exclude
        domain="file"
        path="logs" />
</full-backup-content>
