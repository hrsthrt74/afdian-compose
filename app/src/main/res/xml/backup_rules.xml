<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules（API 23~30 的 full-backup-content 兼容层）。
   日志目录属于本地调试产物，不值得占用云备份配额，也会拖慢备份恢复，
   排除之；崩溃报告要的是「当下」的现场，跨设备恢复旧日志反而会误导排查。
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- 日志目录（运行日志 / 崩溃报告 / 导出文件）不参与云备份 -->
    <exclude
        domain="file"
        path="logs" />
    <!-- DataStore（设置、登录态、浏览历史、搜索历史等）不参与云备份。
         登录凭据是 AndroidKeyStore 加密的密文，与设备绑定，换机后必然解不开，
         备份上去只是给用户换机时制造一个「登录态还在但要用不」的假象；
         浏览历史、缓存的创作者资料等也没有跨设备同步的价值。 -->
    <exclude
        domain="file"
        path="datastore" />
</full-backup-content>
