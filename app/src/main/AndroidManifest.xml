<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur AAR 声明 minSdk=33（依赖 RuntimeShader API），与 legacy 变体的 minSdk=29 冲突。
         legacy 上模糊全部由数据源兜底关闭（ThemeRepository.settings），永不触发该库代码，放行安全。
         对 minSdk>=34 的其他变体无任何影响（仅发生冲突时才生效）。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Afdian">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Afdian.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
