<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur AAR 声明 minSdk=33（依赖 RuntimeShader API），与 legacy 变体的 minSdk=29 冲突。
         legacy 上模糊全部由数据源兜底关闭（ThemeRepository.settings），永不触发该库代码，放行安全。
         对 minSdk>=34 的其他变体无任何影响（仅发生冲突时才生效）。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：把下载好的 APK 交给系统安装器。侧载分发场景，不涉及 Play 政策。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ 包可见性：允许 CustomTabsClient 查询默认浏览器的 CCT 服务，
         以及查询能处理「安装 APK」的系统安装器。 -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".AfdianApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Afdian">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Afdian.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider：日志导出（logs/）与应用内更新（updates/）共用。
             authority 用 ${applicationId} 动态拼接（legacy 变体有 applicationIdSuffix，
             硬编码包名会导致后缀变体上 getUriForFile 直接抛 IllegalArgumentException）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
